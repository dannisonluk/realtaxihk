# --- App ---
# SEC-01: APP_ENV is REQUIRED and whitelisted (dev | test | prod). There is no
# default: an unset APP_ENV is a startup error, because defaulting to "dev" would
# serve a fixed OTP code on a production host. Values like "production" or "PROD"
# are rejected rather than silently skipping the prod safety checks.
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# SEC-31: interface the compose stack publishes the api on. Loopback by default —
# the deployment assumes a TLS terminator in front, so publishing on 0.0.0.0
# handed the network a direct path around it. Set 0.0.0.0 only if the proxy
# genuinely lives on another host.
APP_BIND_IP=127.0.0.1
LOG_LEVEL=INFO
# Whitelisted CORS origins (realtaxihk.com domains + local dev).
#
# BOTH spellings of loopback are listed, for every dev port. An origin is matched
# as a literal string, so `http://127.0.0.1:8081` and `http://localhost:8081` are
# different origins and the browser blocks one of them. That is not a theoretical
# distinction: `admin-web/serve.py` binds 127.0.0.1 and its instructions use
# 127.0.0.1, while the rest of this file uses 127.0.0.1 deliberately (see the
# Postgres note below), so a list containing only `localhost` makes the admin
# console fail every request with an opaque CORS error and no server-side log
# line.
#
# 3000 and 8081 are the admin console's defaults; add a new origin here when
# serving the console from another port.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","http://127.0.0.1:8081"]

# --- PostgreSQL (PostGIS) ---
# 15433/16379 avoid clashes with sibling projects (ineedajob uses 15432/6379)
# Use 127.0.0.1, NOT localhost. On Windows `localhost` resolves to ::1 as well,
# the Docker-published ports are IPv4-only, and the ::1 attempt is dropped
# (not refused) — costing a ~2s timeout per new connection. Measured here:
# localhost 2034ms/connect vs 127.0.0.1 1ms.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_USER=realtaxi
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=realtaxihk

# --- Redis ---
REDIS_PORT=16379
# Local dev redis has no password; the compose stack requires one (REDIS_PASSWORD).
# 127.0.0.1 for the same IPv6-fallback reason as POSTGRES_HOST above.
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_PASSWORD=
# Prefix for every RATE-LIMIT key: `rl:{namespace}{key}:{window}`.
#
# Production never changes this. It exists so a second process sharing one Redis
# cannot delete this process's counters — the test suite sets it to a unique
# value and sweeps `rl:<namespace>*` between tests, which a shared namespace
# would turn into a cross-process reset.
REDIS_KEY_NAMESPACE=realtaxi:

# --- Security ---
# SEC-04: REQUIRED, no default, and must carry real entropy (>= 32 chars, >= 8
# distinct characters). Generate: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# SEC-18: 15 minutes bounds how long a leaked/logged-out access token stays usable.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# SEC-17: replaying a rotated refresh token revokes the whole token family.
REFRESH_REUSE_DETECTION=true
# SEC-02: the deterministic dev OTP (123456, returned in the response) needs BOTH
# a non-prod APP_ENV and this switch. It is rejected outright when APP_ENV=prod.
# Leave unset/false anywhere that is not a developer machine or CI.
ALLOW_DEV_OTP=false
# SEC-07 / SEC-31: number of TRUSTED proxy hops in front of the app.
#   0 = the api is exposed directly (X-Forwarded-For is ignored entirely)
#   1 = one nginx/CDN in front (the client address is taken from the right)
# Anything a client sends beyond the trusted hop count is ignored.
#
# This is the ONLY place the header is trusted. uvicorn's own proxy-header
# handling is deliberately disabled (`--no-proxy-headers`, see the Dockerfile):
# it is ON by default with forwarded_allow_ips=127.0.0.1 and rewrites
# scope["client"] from the client-supplied header BELOW the app, which made every
# IP rate limit spoofable no matter what this setting said.
TRUSTED_PROXY_COUNT=0
# SEC-22: /metrics is only mounted when PROMETHEUS_ENABLED=true AND this is set.
METRICS_TOKEN=
# SEC-24: HSTS is emitted only when APP_ENV=prod.
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_S=31536000

# --- Background jobs (geo sweep + PDPO purges) ---
JOBS_ENABLED=true
GEO_SWEEP_INTERVAL_S=300
MAX_BROADCAST_MINUTES=30
PURGE_INTERVAL_S=86400
RETENTION_DAYS_OTP=30
RETENTION_DAYS_REFRESH=30

# --- Weekly settlement (revenue model: per-driver weekly service fee) ---
# Idempotent per ISO week — re-running the same week never double-charges.
WEEKLY_SETTLEMENT_ENABLED=true
WEEKLY_FEE_HKD=200
WEEKLY_SETTLEMENT_INTERVAL_S=604800
REFUND_MIN_HKD=1

# --- OTP / rate limiting ---
OTP_IP_RATE_LIMIT=10
OTP_IP_WINDOW_S=600
OTP_PHONE_RATE_LIMIT=5
OTP_PHONE_RATE_LIMIT_STRICT=1
OTP_PHONE_WINDOW_S=3600
# SEC-08: SOFT threshold — crossing it alerts and tightens the per-phone budget.
# It never 429s the whole platform (that was a one-attacker login DoS).
OTP_GLOBAL_HOURLY_LIMIT=500
# Hard ceiling: far above the soft cap, this sheds load with 503 + Retry-After.
OTP_GLOBAL_HOURLY_HARD_LIMIT=5000

# --- Request/DoS limits (SEC-09~11) ---
MAX_REQUEST_BODY_BYTES=1048576
FARE_ESTIMATE_IP_RATE_LIMIT=60
FARE_ESTIMATE_IP_WINDOW_S=60
DRIVER_LOCATION_RATE_LIMIT=120
DRIVER_LOCATION_WINDOW_S=60

# --- WebSocket ---
WS_HEARTBEAT_S=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=2000
WS_IDLE_TIMEOUT_S=300
WS_TICKS_PER_SECOND=2
WS_TICK_BURST=5

# --- Email (P-2: registration verification) ---
# SMTP rather than a vendor API: the verification link is low-volume and
# transactional, and SMTP works with any provider (SES, Postmark, a mailbox)
# without adding an SDK and a second credential format to manage.
#
# Leaving SMTP_HOST empty is fine in dev — registration then fails closed with a
# clear error rather than pretending the mail was sent. In prod it is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# How long a verification link stays usable. Long enough to survive an email
# sitting in a queue, short enough that a leaked link is not permanent.
EMAIL_VERIFY_TTL_HOURS=24
# The public origin the API builds verification links from. In prod this must be
# the real HTTPS origin: a link built from the default would send users to
# localhost, and prod startup rejects the default for that reason.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Object storage (P-2 avatars, P-3 licence photos) ---
# Cloudflare R2 via its S3-compatible API. `R2_ENDPOINT_URL` is the ACCOUNT
# endpoint: https://<account_id>.r2.cloudflarestorage.com
#
# These are empty in dev and the app still starts, but licence submission fails
# without them — a driver cannot be onboarded — so all four are required in prod.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read host for the bucket, if one is configured. Empty means the API
# serves images through a signed redirect instead.
R2_PUBLIC_BASE_URL=
# Uploads are presigned by the API and sent straight to R2 by the client, so the
# API never proxies a 5 MB photo through its own worker.
UPLOAD_URL_TTL_S=900
MAX_AVATAR_BYTES=5242880

# --- Account lifecycle (P-4: phone re-verification) ---
# How often a user must re-prove the phone number.
PHONE_REVERIFY_INTERVAL_DAYS=30
# Once due, how long the account keeps working before new business is blocked.
# A grace window rather than an immediate block: the re-verify is triggered by
# the app, and locking a driver out mid-shift because a notification was missed
# is worse than a day of grace.
PHONE_REVERIFY_GRACE_DAYS=7

# --- External services (fill in prod; providers fail-closed when unconfigured) ---
GOOGLE_MAPS_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=
FCM_CREDENTIALS_JSON=

# --- Observability (optional) ---
# Error monitoring only. The SDK's `release` is pinned in code to the API
# version, and request bodies are never sent (PDPO) — see `app/main.py`.
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# --- Business constants ---
DRIVER_DEPOSIT_DEFAULT_HKD=500
NO_SHOW_PENALTY_HKD=50
