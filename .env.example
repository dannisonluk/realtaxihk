# --- App ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Whitelisted CORS origins (realtaxihk.com domains + local dev)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- PostgreSQL (PostGIS) ---
# 15433/16379 avoid clashes with sibling projects (ineedajob uses 15432/6379)
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_USER=realtaxi
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=realtaxihk

# --- Redis ---
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# --- Security ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-change-in-prod-0123456789abcdef-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Background jobs (geo sweep + PDPO purges) ---
JOBS_ENABLED=true
GEO_SWEEP_INTERVAL_S=300
MAX_BROADCAST_MINUTES=30
PURGE_INTERVAL_S=86400
RETENTION_DAYS_OTP=30
RETENTION_DAYS_REFRESH=30

# --- OTP / rate limiting ---
OTP_IP_RATE_LIMIT=10
OTP_IP_WINDOW_S=600
OTP_GLOBAL_HOURLY_LIMIT=500

# --- WebSocket ---
WS_HEARTBEAT_S=30

# --- External services (fill in prod; providers fail-closed when unconfigured) ---
GOOGLE_MAPS_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=
FCM_CREDENTIALS_JSON=

# --- Observability (optional) ---
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# --- Business constants ---
DRIVER_DEPOSIT_DEFAULT_HKD=500
NO_SHOW_PENALTY_HKD=50
