# --- App ---
# SEC-01: APP_ENV is REQUIRED and whitelisted (dev | test | prod). There is no
# default: an unset APP_ENV is a startup error, because defaulting to "dev" would
# serve a fixed OTP code on a production host. Values like "production" or "PROD"
# are rejected rather than silently skipping the prod safety checks.
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# SEC-31: interface the compose stack publishes the api on. Loopback by default —
# the deployment assumes a TLS terminator in front, so publishing on 0.0.0.0
# handed the network a direct path around it. Set 0.0.0.0 only if the proxy
# genuinely lives on another host.
APP_BIND_IP=127.0.0.1
LOG_LEVEL=INFO
# Whitelisted CORS origins (realtaxihk.com domains + local dev)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- PostgreSQL (PostGIS) ---
# 15433/16379 avoid clashes with sibling projects (ineedajob uses 15432/6379)
# Use 127.0.0.1, NOT localhost. On Windows `localhost` resolves to ::1 as well,
# the Docker-published ports are IPv4-only, and the ::1 attempt is dropped
# (not refused) — costing a ~2s timeout per new connection. Measured here:
# localhost 2034ms/connect vs 127.0.0.1 1ms.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_USER=realtaxi
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=realtaxihk

# --- Redis ---
REDIS_PORT=16379
# Local dev redis has no password; the compose stack requires one (REDIS_PASSWORD).
# 127.0.0.1 for the same IPv6-fallback reason as POSTGRES_HOST above.
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_PASSWORD=

# --- Security ---
# SEC-04: REQUIRED, no default, and must carry real entropy (>= 32 chars, >= 8
# distinct characters). Generate: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# SEC-18: 15 minutes bounds how long a leaked/logged-out access token stays usable.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# SEC-17: replaying a rotated refresh token revokes the whole token family.
REFRESH_REUSE_DETECTION=true
# SEC-02: the deterministic dev OTP (123456, returned in the response) needs BOTH
# a non-prod APP_ENV and this switch. It is rejected outright when APP_ENV=prod.
# Leave unset/false anywhere that is not a developer machine or CI.
ALLOW_DEV_OTP=false
# SEC-07 / SEC-31: number of TRUSTED proxy hops in front of the app.
#   0 = the api is exposed directly (X-Forwarded-For is ignored entirely)
#   1 = one nginx/CDN in front (the client address is taken from the right)
# Anything a client sends beyond the trusted hop count is ignored.
#
# This is the ONLY place the header is trusted. uvicorn's own proxy-header
# handling is deliberately disabled (`--no-proxy-headers`, see the Dockerfile):
# it is ON by default with forwarded_allow_ips=127.0.0.1 and rewrites
# scope["client"] from the client-supplied header BELOW the app, which made every
# IP rate limit spoofable no matter what this setting said.
TRUSTED_PROXY_COUNT=0
# SEC-22: /metrics is only mounted when PROMETHEUS_ENABLED=true AND this is set.
METRICS_TOKEN=
# SEC-24: HSTS is emitted only when APP_ENV=prod.
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_S=31536000

# --- Background jobs (geo sweep + PDPO purges) ---
JOBS_ENABLED=true
GEO_SWEEP_INTERVAL_S=300
MAX_BROADCAST_MINUTES=30
PURGE_INTERVAL_S=86400
RETENTION_DAYS_OTP=30
RETENTION_DAYS_REFRESH=30

# --- Weekly settlement (revenue model: per-driver weekly service fee) ---
# Idempotent per ISO week — re-running the same week never double-charges.
WEEKLY_SETTLEMENT_ENABLED=true
WEEKLY_FEE_HKD=200
WEEKLY_SETTLEMENT_INTERVAL_S=604800
REFUND_MIN_HKD=1

# --- OTP / rate limiting ---
OTP_IP_RATE_LIMIT=10
OTP_IP_WINDOW_S=600
OTP_PHONE_RATE_LIMIT=5
OTP_PHONE_RATE_LIMIT_STRICT=1
OTP_PHONE_WINDOW_S=3600
# SEC-08: SOFT threshold — crossing it alerts and tightens the per-phone budget.
# It never 429s the whole platform (that was a one-attacker login DoS).
OTP_GLOBAL_HOURLY_LIMIT=500
# Hard ceiling: far above the soft cap, this sheds load with 503 + Retry-After.
OTP_GLOBAL_HOURLY_HARD_LIMIT=5000

# --- Request/DoS limits (SEC-09~11) ---
MAX_REQUEST_BODY_BYTES=1048576
FARE_ESTIMATE_IP_RATE_LIMIT=60
FARE_ESTIMATE_IP_WINDOW_S=60
DRIVER_LOCATION_RATE_LIMIT=120
DRIVER_LOCATION_WINDOW_S=60

# --- WebSocket ---
WS_HEARTBEAT_S=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=2000
WS_IDLE_TIMEOUT_S=300
WS_TICKS_PER_SECOND=2
WS_TICK_BURST=5

# --- External services (fill in prod; providers fail-closed when unconfigured) ---
GOOGLE_MAPS_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=
FCM_CREDENTIALS_JSON=

# --- Observability (optional) ---
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# --- Business constants ---
DRIVER_DEPOSIT_DEFAULT_HKD=500
NO_SHOW_PENALTY_HKD=50
