# --- App ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# Whitelisted CORS origins (realtaxihk.com domains + local dev)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- PostgreSQL (PostGIS) ---
# 15433/16379 avoid clashes with sibling projects (ineedajob uses 15432/6379)
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_USER=realtaxi
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=realtaxihk

# --- Redis ---
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# --- Security ---
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-change-in-prod-0123456789abcdef-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- External services (fill in prod) ---
GOOGLE_MAPS_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FCM_CREDENTIALS_JSON=

# --- Business constants ---
DRIVER_DEPOSIT_DEFAULT_HKD=500
NO_SHOW_PENALTY_HKD=50
